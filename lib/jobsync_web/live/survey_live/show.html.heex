<p>hell</p>
<.link patch={~p"/survey"}>Go back</.link>
<.link patch={~p"/survey/#{@job}/show/edit"}>
  edit
</.link>
<.list>
  <:item title="Company">
    {@job.company}
  </:item>
  <:item title="title">
    {@job.title}
  </:item>
  <:item title="status">
    {@job.status}
  </:item>
  <:item title="cover_letter">
    {show_key(@job.cover_letter)}
  </:item>
  <:item title="job description">
    {show_key(@job.job_description)}
  </:item>
  <:item title="resume">
    {show_key(@job.resume_key)}
  </:item>
  <:item title="notes">
    {@job.notes}
  </:item>
</.list>

<div id="hook-guy" phx-hook="DownloadHook" class="flex gap-40">
  <%= if @job.resume_key do %>
    <.link phx-click={JS.push("download", value: %{resume_key: @job.resume_key})}>
      Download Resume
    </.link>
  <% end %>
  <%= if @job.cover_letter do %>
    <.link phx-click={JS.push("download", value: %{resume_key: @job.cover_letter})}>
      Download Cover Letter
    </.link>
  <% end %>
  <%= if @job.job_description do %>
    <.link phx-click={JS.push("download", value: %{resume_key: @job.job_description})}>
      Download JobDescription
    </.link>
  <% end %>
</div>

<.modal :if={@live_action in [:edit]} show="true" id="garbage-id">
  <h1>Editing baby</h1>
  <.live_component
    module={JobsyncWeb.SurveyLive.FormComponent}
    id={@job.id}
    job={@job}
    action={@live_action}
    patch={~p"/survey/#{@job}"}
  />
</.modal>
