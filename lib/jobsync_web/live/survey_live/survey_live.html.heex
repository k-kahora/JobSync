<div class="grid grid-cols-12 min-h-screen gap-4">
  <div class="row-span-11 bento"></div>
  <div class="col-span-11 grid grid-cols-subgrid">
    <div class="bento col-span-3" phx-drop-target={@uploads.document.ref}>
      <form
        id="goal-form"
        phx-submit="submit-file"
        phx-change="validate-upload"
        phx-drop-target={@uploads.document.ref}
      >
        hi <.live_file_input upload={@uploads.document} />
        <button type="submit">click me</button>
      </form>

      <%!-- <%= for image <- @uploads.document.entries do %> --%>
      <%!-- <progress value={image.progress} max="100" /> --%>

      {inspect(@uploads.document.entries)}
      <%= for doc <- @uploads.document.entries do %>
        <progress value={doc.progress} max="100" />
      <% end %>
      <%!-- # <% end %> --%>
    </div>
    <div class="bento col-start-8 col-span-4"></div>
    <%!-- <div class="bento col-span-2">1</div> --%>
    <%!-- <div class="bento col-span-2">1</div> --%>
  </div>
  <div class="col-span-7 row-span-3 grid grid-cols-subgrid">
    <div class="col-span-3 bento">
      <%!-- <Component.card form={@form}></Component.card> --%>
    </div>
    <div class="col-span-2 bento">
      <Base.total unit="" number={10} heading="this week" previous={3} footer="from last week" />
    </div>
    <div class="col-span-2 bento"></div>
  </div>
  <div class="bento col-span-4 row-span-10">4</div>
  <div class="col-span-7 row-span-7 grid grid-rows-subgrid">
    <div class="bento row-span-1"></div>
    <div class="bento row-span-6" id="hook-guy" phx-hook="DownloadHook">
      <.link patch={~p"/survey/new"}>
        New
      </.link>
      <Base.table
        id="why"
        rows={@streams.jobs}
        action={@live_action}
        row_click={fn {id, job} -> JS.navigate(~p"/survey/#{job}") end}
        phx-update="stream"
      >
        <:col :let={{_, job}} label="company">{job.company}</:col>
        <:col :let={{_, job}} label="title">{job.title}</:col>
        <:col :let={{_, job}} label="status">{job.status}</:col>
        <%!-- <:col :let={job} label="notes">{job.notes}</:col> --%>
        <%!-- <:col :let={job} label="description">{job.description}</:col> --%>
        <:action :let={{id, job}}>
          <.link patch={~p"/survey/#{job}/edit"}><button>Edit</button></.link>
          <.link phx-click={JS.push("delete", value: %{id: job.id})} data-confirm="Are you sure">
            delete
          </.link>
          <.link phx-click={JS.push("download", value: %{resume_key: job.resume_key})}>
            Download
          </.link>
        </:action>
      </Base.table>
    </div>
  </div>
</div>

<.modal
  :if={@live_action in [:edit, :new]}
  show={true}
  id="what-th-hell"
  on_cancel={JS.patch(~p"/survey")}
>
  <.live_component
    module={JobsyncWeb.SurveyLive.FormComponent}
    job={@job}
    id="what"
    action={@live_action}
    patch={~p"/survey"}
  />
</.modal>
